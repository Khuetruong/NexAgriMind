# Sao thành .env và điền giá trị thật. KHÔNG đưa .env và clients.yaml lên git.
AGRIMIND_DOMAIN=api-vn.example.vn
# Mật khẩu/khoá nội bộ: tạo bằng  openssl rand -base64 32
QDRANT_API_KEY=
NEO4J_PASSWORD=
# Dịch vụ tenant của Nexagri trong nước và khoá dịch vụ nội bộ (cùng khoá Nexagri dùng)
NEXAGRI_TENANT_URL=http://10.0.0.10:9011
INTERNAL_SERVICE_KEY=
# Không có GPU trên máy này: trỏ tới máy GPU thuê theo giờ (API tương thích OpenAI)
# AGRIMIND_LLM_URL=http://<máy-gpu>:8000/v1
# Hỏi Core khi kho trong nước chưa đủ (khoá do Core cấp, chỉ quyền ask:general)
AGRIMIND_CORE_URL=
AGRIMIND_CORE_KEY=
